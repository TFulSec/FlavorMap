<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <remove name="WebDAV" />
      <add
        name="httpPlatformHandler"
        path="*"
        verb="*"
        modules="httpPlatformHandler"
        resourceType="Unspecified"
      />
    </handlers>

    <httpPlatform
      processPath="node"
      arguments="backend/src/app.js"
      startupTimeLimit="120"
      startupRetryCount="3"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\node-stdout"
    >
      <environmentVariables>
        <environmentVariable
          name="PORT"
          value="%HTTP_PLATFORM_PORT%"
        />
        <environmentVariable
          name="NODE_ENV"
          value="production"
        />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

    <httpErrors
      errorMode="DetailedLocalOnly"
      existingResponse="PassThrough"
    />
  </system.webServer>
</configuration>
