PORT=3000
CLIENT_URL=http://localhost:3000,https://tfulsec.site,https://www.tfulsec.site
NODE_ENV=development
# Chỉ bật khi ứng dụng thật sự đứng sau đúng 1 reverse proxy (Nginx/Cloudflare).
# TRUST_PROXY=1

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FlavorMap
DB_USER=sa
DB_PASSWORD=change-me
DB_ENCRYPT=false
DB_TRUST_CERT=true
DB_CONNECT_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
# FORCE_MOCK_DB=true

# Dùng chuỗi ngẫu nhiên dài ít nhất 32 byte. Không commit file .env.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
VIEW_HASH_SECRET=replace-with-another-long-random-secret

# Danh sách từ/cụm từ bổ sung cần chặn trong đánh giá, phân tách bằng dấu phẩy.
# REVIEW_BLOCKED_WORDS=tu-cam-1,tu-cam-2

# Swagger: https://tfulsec.site/api-docs/
# CLIENT_URL=* cũng được hỗ trợ, nhưng production nên liệt kê rõ domain.
